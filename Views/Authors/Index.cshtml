@model IEnumerable<BookNest.Models.Author>

@{
    ViewData["Title"] = "Authors";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="fw-bold">✍️ Authors</h1>
        <p class="text-muted mb-0">
            Manage your favorite authors.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        ➕ Add New Author
    </a>

</div>

<!-- 🔍 Search Form -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="row g-2">
        <div class="col-md-6">
            <input type="text" 
                   name="searchString" 
                   value="@ViewData["SearchString"]" 
                   class="form-control" 
                   placeholder="🔍 Search authors by name..." />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">
                Search
            </button>
        </div>
        <div class="col-md-2">
            <a asp-action="Index" class="btn btn-outline-secondary w-100">
                Clear
            </a>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info text-center p-4">

        <h4>✍️ No authors yet!</h4>

        <p>
            Start by adding your first author.
        </p>

        <a asp-action="Create" class="btn btn-primary">
            ➕ Add Your First Author
        </a>

    </div>
}
else
{
    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">

                <div class="card shadow-sm h-100">

                    <div class="card-body d-flex flex-column">

                        <div class="text-center mb-3"
                             style="font-size: 60px;">
                            ✍️
                        </div>

                        <h4 class="card-title text-center fw-bold">
                            @item.Name
                        </h4>

                        @if (!string.IsNullOrEmpty(item.Biography))
                        {
                            <p class="card-text text-muted">
                                @item.Biography
                            </p>
                        }
                        else
                        {
                            <p class="card-text text-muted text-center">
                                No biography available.
                            </p>
                        }

                        <!-- 📚 Book count badge -->
                        <div class="mt-2 mb-3 text-center">
                            <span class="badge bg-info">
                                📚 @item.Books.Count book@(item.Books.Count != 1 ? "s" : "")
                            </span>
                        </div>

                        <div class="mt-auto pt-3 text-center">

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-primary btn-sm">
                                Details
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-warning btn-sm">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-danger btn-sm">
                                Delete
                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>
}