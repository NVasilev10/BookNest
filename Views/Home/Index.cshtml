@{
    ViewData["Title"] = "BookNest - Your Digital Library";
}

<div class="text-center py-5">

    <h1 class="display-3 fw-bold">
        📚 Welcome to BookNest
    </h1>

    <p class="lead text-muted mt-3">
        Your personal digital library for managing books, authors and categories.
    </p>

    <div class="mt-4">

        <a asp-controller="Books"
           asp-action="Index"
           class="btn btn-primary btn-lg me-2">
            📚 Browse Books
        </a>

        <a asp-controller="Books"
           asp-action="Create"
           class="btn btn-success btn-lg">
            ➕ Add New Book
        </a>

    </div>

</div>

<hr class="my-5" />


<!-- 📊 Statistics -->
<div class="row text-center mb-5">

    <!-- Books -->
    <div class="col-md-3 mb-4">

        <div class="card shadow-sm h-100">

            <div class="card-body">

                <h1 class="display-4">📚</h1>

                <h2 class="fw-bold">
                    @ViewBag.BooksCount
                </h2>

                <p class="text-muted">
                    Books
                </p>

                <a asp-controller="Books"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                    View Books
                </a>

            </div>

        </div>

    </div>


    <!-- Favorites -->
    <div class="col-md-3 mb-4">

        <div class="card shadow-sm h-100">

            <div class="card-body">

                <h1 class="display-4">⭐</h1>

                <h2 class="fw-bold">
                    @ViewBag.FavoritesCount
                </h2>

                <p class="text-muted">
                    Favorite Books
                </p>

                <a asp-controller="Books"
                   asp-action="Index"
                   asp-route-favoritesOnly="true"
                   class="btn btn-outline-warning">
                    View Favorites
                </a>

            </div>

        </div>

    </div>


    <!-- Authors -->
    <div class="col-md-3 mb-4">

        <div class="card shadow-sm h-100">

            <div class="card-body">

                <h1 class="display-4">✍️</h1>

                <h2 class="fw-bold">
                    @ViewBag.AuthorsCount
                </h2>

                <p class="text-muted">
                    Authors
                </p>

                <a asp-controller="Authors"
                   asp-action="Index"
                   class="btn btn-outline-warning">
                    View Authors
                </a>

            </div>

        </div>

    </div>


    <!-- Categories -->
    <div class="col-md-3 mb-4">

        <div class="card shadow-sm h-100">

            <div class="card-body">

                <h1 class="display-4">🏷️</h1>

                <h2 class="fw-bold">
                    @ViewBag.CategoriesCount
                </h2>

                <p class="text-muted">
                    Categories
                </p>

                <a asp-controller="Categories"
                   asp-action="Index"
                   class="btn btn-outline-success">
                    View Categories
                </a>

            </div>

        </div>

    </div>

</div>


<div class="text-center text-muted mt-4">

    <p>
        📖 Keep your library organized with BookNest.
    </p>

</div>

<hr class="my-5" />

<!-- 📚 Recent Books -->
@if (ViewBag.RecentBooks != null && ((List<BookNest.Models.Book>)ViewBag.RecentBooks).Any())
{
    <section class="mb-5">
        <h2 class="mb-4">
            <span class="badge bg-info">NEW</span> Recent Books
        </h2>

        <div class="row">
            @foreach (var book in ViewBag.RecentBooks)
            {
                <div class="col-md-4 mb-3">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(book.ImageUrl))
                        {
                            <img src="@book.ImageUrl" class="card-img-top" alt="@book.Title" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-light" style="height: 200px; font-size: 50px;">
                                📚
                            </div>
                        }

                        <div class="card-body">
                            <h5 class="card-title">@book.Title</h5>
                            <p class="text-muted small">✍️ @book.Author?.Name</p>
                            <p class="text-muted small">🏷️ @book.Category?.Name</p>
                            @if (book.IsFavorite)
                            {
                                <span class="badge bg-warning text-dark">⭐ Favorite</span>
                            }
                        </div>
                        <div class="card-footer bg-light">
                            <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-primary w-100">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

<!-- ⭐ Favorite Books -->
@if (ViewBag.FavoriteBooks != null && ((List<BookNest.Models.Book>)ViewBag.FavoriteBooks).Any())
{
    <section class="mb-5">
        <h2 class="mb-4">
            <span class="badge bg-warning">FAVORITES</span> Your Favorite Books
        </h2>

        <div class="row">
            @foreach (var book in ViewBag.FavoriteBooks)
            {
                <div class="col-md-4 mb-3">
                    <div class="card h-100 shadow-sm border-warning">
                        @if (!string.IsNullOrEmpty(book.ImageUrl))
                        {
                            <img src="@book.ImageUrl" class="card-img-top" alt="@book.Title" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-light" style="height: 200px; font-size: 50px;">
                                📚
                            </div>
                        }

                        <div class="card-body">
                            <h5 class="card-title">⭐ @book.Title</h5>
                            <p class="text-muted small">✍️ @book.Author?.Name</p>
                            <p class="text-muted small">🏷️ @book.Category?.Name</p>
                        </div>
                        <div class="card-footer bg-light">
                            <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-warning w-100">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}