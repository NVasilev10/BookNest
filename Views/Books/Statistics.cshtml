@model dynamic

@{
	ViewData["Title"] = "Book Statistics";
	int totalBooks = (int)ViewData["TotalBooks"];
	int totalAuthors = (int)ViewData["TotalAuthors"];
	int totalCategories = (int)ViewData["TotalCategories"];
	int totalFavorites = (int)ViewData["TotalFavorites"];
	int totalReviews = (int)ViewData["TotalReviews"];
	double averageRating = (double)ViewData["AverageRating"];
	var popularAuthors = (List<BookNest.Models.Author>)ViewData["PopularAuthors"];
	var popularCategories = (List<BookNest.Models.Category>)ViewData["PopularCategories"];
	var topRatedBooks = (List<BookNest.Models.Book>)ViewData["TopRatedBooks"];
}

<div class="mb-4">
	<a asp-action="Index" class="btn btn-outline-secondary">
		← Back to Books
	</a>
</div>

<h1 class="mb-4">📊 Book Collection Statistics</h1>

<!-- Summary Cards -->
<div class="row g-3 mb-5">
	<div class="col-md-4">
		<div class="card text-center shadow-sm bg-primary text-white">
			<div class="card-body">
				<h6 class="card-title">📚 Total Books</h6>
				<h2 class="mb-0">@totalBooks</h2>
			</div>
		</div>
	</div>

	<div class="col-md-4">
		<div class="card text-center shadow-sm bg-success text-white">
			<div class="card-body">
				<h6 class="card-title">⭐ Average Rating</h6>
				<h2 class="mb-0">@averageRating.ToString("F1")/5</h2>
				<small>From @totalReviews reviews</small>
			</div>
		</div>
	</div>

	<div class="col-md-4">
		<div class="card text-center shadow-sm bg-warning text-dark">
			<div class="card-body">
				<h6 class="card-title">⭐ Favorites</h6>
				<h2 class="mb-0">@totalFavorites</h2>
			</div>
		</div>
	</div>

	<div class="col-md-4">
		<div class="card text-center shadow-sm bg-info text-white">
			<div class="card-body">
				<h6 class="card-title">✍️ Authors</h6>
				<h2 class="mb-0">@totalAuthors</h2>
			</div>
		</div>
	</div>

	<div class="col-md-4">
		<div class="card text-center shadow-sm bg-danger text-white">
			<div class="card-body">
				<h6 class="card-title">🏷️ Categories</h6>
				<h2 class="mb-0">@totalCategories</h2>
			</div>
		</div>
	</div>

	<div class="col-md-4">
		<div class="card text-center shadow-sm bg-secondary text-white">
			<div class="card-body">
				<h6 class="card-title">💬 Reviews</h6>
				<h2 class="mb-0">@totalReviews</h2>
			</div>
		</div>
	</div>
</div>

<!-- Popular Authors -->
<div class="card shadow-sm mb-4">
	<div class="card-header bg-primary text-white">
		<h5 class="mb-0">✍️ Top 5 Authors (by book count)</h5>
	</div>
	<div class="card-body">
		@if (popularAuthors.Any())
		{
			<div class="row">
				@foreach (var author in popularAuthors)
				{
					<div class="col-md-6 mb-3">
						<div class="d-flex justify-content-between align-items-center p-3 bg-light rounded">
							<div>
								<h6 class="mb-1">@author.Name</h6>
								<small class="text-muted">@author.Biography</small>
							</div>
							<div class="text-end">
								<span class="badge bg-primary">@author.Books.Count book@(author.Books.Count != 1 ? "s" : "")</span>
							</div>
						</div>
					</div>
				}
			</div>
		}
		else
		{
			<p class="text-muted text-center">No authors yet.</p>
		}
	</div>
</div>

<!-- Popular Categories -->
<div class="card shadow-sm mb-4">
	<div class="card-header bg-danger text-white">
		<h5 class="mb-0">🏷️ Top 5 Categories (by book count)</h5>
	</div>
	<div class="card-body">
		@if (popularCategories.Any())
		{
			<div class="row">
				@foreach (var category in popularCategories)
				{
					<div class="col-md-6 mb-3">
						<div class="d-flex justify-content-between align-items-center p-3 bg-light rounded">
							<div>
								<h6 class="mb-1">@category.Name</h6>
								<small class="text-muted">@category.Description</small>
							</div>
							<div class="text-end">
								<span class="badge bg-danger">@category.Books.Count book@(category.Books.Count != 1 ? "s" : "")</span>
							</div>
						</div>
					</div>
				}
			</div>
		}
		else
		{
			<p class="text-muted text-center">No categories yet.</p>
		}
	</div>
</div>

<!-- Top Rated Books -->
<div class="card shadow-sm">
	<div class="card-header bg-success text-white">
		<h5 class="mb-0">⭐ Top 5 Rated Books</h5>
	</div>
	<div class="card-body">
		@if (topRatedBooks.Any())
		{
			<div class="table-responsive">
				<table class="table table-hover">
					<thead class="table-light">
						<tr>
							<th>Book Title</th>
							<th>Author</th>
							<th>Rating</th>
							<th>Reviews</th>
							<th>Action</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var book in topRatedBooks)
						{
							var bookRating = book.Reviews.Any() ? book.Reviews.Average(r => r.Rating) : 0;
							<tr>
								<td><strong>@book.Title</strong></td>
								<td>@book.Author?.Name</td>
								<td>
									<span class="text-warning">★</span>
									@bookRating.ToString("F1") / 5
								</td>
								<td>
									<span class="badge bg-info">@book.Reviews.Count</span>
								</td>
								<td>
									<a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-outline-primary">
										View
									</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		else
		{
			<p class="text-muted text-center">No books with reviews yet.</p>
		}
	</div>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
