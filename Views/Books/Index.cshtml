@model IEnumerable<BookNest.Models.Book>

@{
	ViewData["Title"] = "Books";
	bool favoritesOnly = ViewData["FavoritesOnly"] as bool? ?? false;
}

<div class="d-flex justify-content-between align-items-center mb-4">
	<div>
		<h1>📚 Books</h1>
		<p class="text-muted mb-0">
			Browse and manage your book collection.
		</p>
		@if (ViewData["SearchString"] != null || ViewData["FavoritesOnly"] as bool? == true)
		{
			<small class="text-success">
				✓ Found <strong>@ViewData["ResultCount"]</strong> book(s)
			</small>
		}
		<br />
		<small class="text-warning">
			⭐ <strong>@ViewData["FavoritesCount"]</strong> favorite(s)
		</small>
	</div>

	<div>
		<a asp-action="Statistics" class="btn btn-info me-2">
			📊 Statistics
		</a>
		<a asp-action="MyRatings" class="btn btn-secondary me-2">
			👤 My Ratings
		</a>
		<a asp-action="MyCollections" class="btn btn-outline-primary me-2">
			📚 My Collections
		</a>
		<a asp-action="Favorites" class="btn btn-warning me-2">
			⭐ My Favorites (@ViewData["FavoritesCount"])
		</a>
		<div class="btn-group me-2" role="group">
			<button id="exportBtn" type="button" class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
				📥 Export
			</button>
			<ul class="dropdown-menu" aria-labelledby="exportBtn">
				<li>
					<a class="dropdown-item" asp-action="ExportAsCsv" 
					   asp-route-searchString="@ViewData["SearchString"]"
					   asp-route-authorId="@ViewData["AuthorId"]"
					   asp-route-categoryId="@ViewData["CategoryId"]"
					   asp-route-favoritesOnly="@ViewData["FavoritesOnly"]">
						📄 Export as CSV
					</a>
				</li>
				<li>
					<a class="dropdown-item" asp-action="ExportAsJson"
					   asp-route-searchString="@ViewData["SearchString"]"
					   asp-route-authorId="@ViewData["AuthorId"]"
					   asp-route-categoryId="@ViewData["CategoryId"]"
					   asp-route-favoritesOnly="@ViewData["FavoritesOnly"]">
						📋 Export as JSON
					</a>
				</li>
			</ul>
		</div>
		<a asp-controller="Books" asp-action="Create" class="btn btn-success">
			➕ Add New Book
		</a>
	</div>
</div>

<!-- 🔍 Search and Filters -->
<form asp-action="Index" method="get" class="mb-4">
	<div class="row g-2">
		<!-- Advanced Search -->
		<div class="col-md-4">
			<div class="input-group">
				<span class="input-group-text">🔍</span>
				<input type="text"
					   name="searchString"
					   value="@ViewData["SearchString"]"
					   class="form-control"
					   placeholder="Search by title, description, author..." 
					   title="Search across titles, descriptions, and author names" />
			</div>
			<small class="text-muted d-block mt-1">Searches title, description & author</small>
		</div>

		<!-- Author Filter -->
		<div class="col-md-3">
			<select name="authorId"
					class="form-select"
					asp-items="ViewBag.Authors">
				<option value="">✍️ All Authors</option>
			</select>
		</div>

		<!-- Category Filter -->
		<div class="col-md-3">
			<select name="categoryId"
					class="form-select"
					asp-items="ViewBag.Categories">
				<option value="">🏷️ All Categories</option>
			</select>
		</div>

		<!-- Sort By -->
		<div class="col-md-2">
			@{
				var currentSort = ViewData["SortBy"]?.ToString() ?? "title";
			}
			<select name="sortBy" class="form-select">
				<option value="title" selected="@(currentSort == "title" ? "selected" : null)">Sort: Title</option>
				<option value="rating_high" selected="@(currentSort == "rating_high" ? "selected" : null)">⭐ Highest Rated</option>
				<option value="rating_low" selected="@(currentSort == "rating_low" ? "selected" : null)">⭐ Lowest Rated</option>
				<option value="newest" selected="@(currentSort == "newest" ? "selected" : null)">📅 Newest First</option>
				<option value="oldest" selected="@(currentSort == "oldest" ? "selected" : null)">📅 Oldest First</option>
			</select>
		</div>

		<!-- Search Button -->
		<div class="col-md-2">
			<button type="submit" class="btn btn-primary w-100">
				🔍 Search
			</button>
		</div>
	</div>

	<!-- ⭐ Favorites Filter -->
	<div class="row mt-3">
		<div class="col-md-6">
			<div class="form-check">
				<input class="form-check-input"
					   type="checkbox"
					   name="favoritesOnly"
					   value="true"
					   id="favoritesOnly"
				@(favoritesOnly ? "checked" : "") 
					   onchange="this.form.submit()" />
				<label class="form-check-label" for="favoritesOnly">
					⭐ Show Favorites Only
				</label>
			</div>
		</div>

		<div class="col-md-6 text-md-end">
			<a asp-action="Index" class="btn btn-secondary btn-sm">
				🧹 Clear Filters
			</a>
			<a asp-action="Favorites" class="btn btn-warning btn-sm ms-2">
				⭐ View All Favorites
			</a>
		</div>
	</div>
</form>

@if (!Model.Any())
{
	<div class="alert alert-info text-center p-4">
		<h4>📚 No books found!</h4>
		<p>
			Try changing your search or filters.
		</p>
		<a asp-action="Index" class="btn btn-secondary me-2">
			🧹 Clear Filters
		</a>
		<a asp-controller="Books" asp-action="Create" class="btn btn-success">
			➕ Add New Book
		</a>
	</div>
}
else
{
	<div class="row">
		@foreach (var item in Model)
		{
			<div class="col-md-6 col-lg-4 mb-4">
				<div class="card shadow-sm h-100 border-0">
					<!-- 🖼️ Book Image -->
					@if (!string.IsNullOrEmpty(item.ImageUrl))
					{
						<img src="@item.ImageUrl"
							 class="card-img-top"
							 alt="@item.Title"
							 style="height: 300px; object-fit: cover;" />
					}
					else
					{
						<div class="d-flex align-items-center justify-content-center bg-light"
							 style="height: 300px; font-size: 80px;">
							📚
						</div>
					}

					<div class="card-body d-flex flex-column">
						<!-- Badges Row -->
						<div class="mb-3 d-flex flex-wrap gap-2">
							<!-- ⭐ Favorite Badge -->
							@if (item.IsFavorite)
							{
								<span class="badge bg-warning text-dark">⭐ Favorite</span>
							}

							<!-- 📊 Reading Status Badge -->
							@{
								string statusClass = "badge bg-secondary";
								string statusText = "Unknown";

								if (item.Status == BookNest.Models.ReadingStatus.WantToRead)
								{
									statusClass = "badge-want-to-read";
									statusText = "📗 Want to Read";
								}
								else if (item.Status == BookNest.Models.ReadingStatus.Reading)
								{
									statusClass = "badge-reading";
									statusText = "📖 Reading";
								}
								else if (item.Status == BookNest.Models.ReadingStatus.Finished)
								{
									statusClass = "badge-finished";
									statusText = "✅ Finished";
								}
							}
							<span class="@statusClass">@statusText</span>
						</div>

						<!-- Title -->
						<h5 class="card-title">
							<a asp-action="Details" asp-route-id="@item.Id" style="text-decoration: none; color: inherit;">
								@item.Title
							</a>
						</h5>

						<!-- Author & Category -->
						<p class="card-text small text-muted mb-3">
							✍️ @(item.Author?.Name ?? "Unknown")<br />
							🏷️ @(item.Category?.Name ?? "Unknown")
						</p>

						<!-- 📊 Progress Tracker (if has pages) -->
						@if (item.TotalPages.HasValue && item.TotalPages > 0)
						{
							<div class="progress-tracker mb-3">
								<div class="progress-tracker-title">📖 Reading Progress</div>
								<div class="progress">
									<div class="progress-bar" role="progressbar" 
										 style="width: @(item.ProgressPercentage)%;" 
										 aria-valuenow="@item.ProgressPercentage" 
										 aria-valuemin="0" 
										 aria-valuemax="100">
										@item.ProgressPercentage%
									</div>
								</div>
								<div class="progress-tracker-stats">
									<span>📄 @item.PagesRead / @item.TotalPages pages</span>
									<span class="fw-bold">@item.ProgressPercentage%</span>
								</div>
							</div>
						}

						<!-- 📅 Reading Dates -->
						@if (item.StartDate.HasValue || item.FinishDate.HasValue)
						{
							<div class="reading-dates mb-3">
								@if (item.StartDate.HasValue)
								{
									<div class="date-badge start-date">
										<div class="date-badge-label">📅 Started</div>
										<div class="date-badge-value">@item.StartDate.Value.ToString("MMM d, yyyy")</div>
									</div>
								}
								@if (item.FinishDate.HasValue)
								{
									<div class="date-badge finish-date">
										<div class="date-badge-label">✅ Finished</div>
										<div class="date-badge-value">@item.FinishDate.Value.ToString("MMM d, yyyy")</div>
									</div>
								}
							</div>
						}

						<!-- Description (truncated) -->
						@if (!string.IsNullOrEmpty(item.Description))
						{
							<p class="card-text small text-muted mb-3">
								@(item.Description.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)
							</p>
						}

						<!-- Publication Year -->
						<p class="card-text small text-secondary mb-auto">
							📅 Published: @item.PublishedYear
						</p>

						<!-- Action Buttons -->
						<div class="btn-group-vertical w-100 mt-3" role="group">
							<a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
								👁️ View Details
							</a>
							<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm">
								✏️ Edit
							</a>
							<a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">
								🗑️ Delete
							</a>
						</div>
					</div>
				</div>
			</div>
		}
	</div>
}
