@model IEnumerable<BookNest.Models.Book>

@{
    ViewData["Title"] = "Books";
    bool favoritesOnly = ViewData["FavoritesOnly"] as bool? ?? false;
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1>📚 Books</h1>
        <p class="text-muted mb-0">
            Browse and manage your book collection.
        </p>
    </div>

    <a asp-controller="Books" asp-action="Create" class="btn btn-success">
        ➕ Add New Book
    </a>

</div>


<!-- 🔍 Search and Filters -->
<form asp-action="Index" method="get" class="mb-4">

    <div class="row g-2">

        <!-- Search -->
        <div class="col-md-4">
            <input type="text"
                   name="searchString"
                   value="@ViewData["SearchString"]"
                   class="form-control"
                   placeholder="🔍 Search by title..." />
        </div>

        <!-- Author Filter -->
        <div class="col-md-3">
            <select name="authorId"
                    class="form-select"
                    asp-items="ViewBag.Authors">

                <option value="">✍️ All Authors</option>

            </select>
        </div>

        <!-- Category Filter -->
        <div class="col-md-3">
            <select name="categoryId"
                    class="form-select"
                    asp-items="ViewBag.Categories">

                <option value="">🏷️ All Categories</option>

            </select>
        </div>

        <!-- Search Button -->
        <div class="col-md-2">
            <button type="submit"
                    class="btn btn-primary w-100">
                🔍 Search
            </button>
        </div>

    </div>


    <!-- ⭐ Favorites Filter -->
    <div class="row mt-3">

        <div class="col-md-6">

            <div class="form-check">

                <input class="form-check-input"
                       type="checkbox"
                       name="favoritesOnly"
                       value="true"
                       id="favoritesOnly"
                @(favoritesOnly ? "checked" : "") />

                <label class="form-check-label"
                       for="favoritesOnly">
                    ⭐ Show Favorites Only
                </label>

            </div>

        </div>


        <div class="col-md-6 text-md-end">

            <a asp-action="Index"
               class="btn btn-secondary btn-sm">
                🧹 Clear Filters
            </a>

        </div>

    </div>

</form>


@if (!Model.Any())
{
    <div class="alert alert-info text-center p-4">

        <h4>📚 No books found!</h4>

        <p>
            Try changing your search or filters.
        </p>

        <a asp-action="Index"
           class="btn btn-secondary me-2">
            🧹 Clear Filters
        </a>

        <a asp-controller="Books" asp-action="Create"
           class="btn btn-success">
            ➕ Add New Book
        </a>

    </div>
}
else
{
    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">

                <div class="card shadow-sm h-100">

                    <!-- 🖼️ Book Image -->
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl"
                             class="card-img-top"
                             alt="@item.Title"
                             style="height: 300px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center bg-light"
                             style="height: 300px; font-size: 80px;">
                            📚
                        </div>
                    }


                    <div class="card-body d-flex flex-column">

                        <!-- ⭐ Favorite Badge -->
                        @if (item.IsFavorite)
                        {
                            <div class="mb-2">
                                <span class="badge bg-warning text-dark">
                                    ⭐ Favorite
                                </span>
                            </div>
                        }


                        <h4 class="card-title">
                            @item.Title
                        </h4>


                        <p class="text-muted mb-2">
                            ✍️ @item.Author?.Name
                        </p>


                        <p class="mb-2">
                            🏷️ @item.Category?.Name
                        </p>


                        <p class="text-muted small">
                            📅 @item.PublishedYear
                        </p>


                        @if (!string.IsNullOrEmpty(item.Description))
                        {
                            <p class="card-text">
                                @(item.Description.Length > 120
                                    ? item.Description.Substring(0, 120) + "..."
                                    : item.Description)
                            </p>
                        }


                        <div class="mt-auto pt-3">

                            <!-- ⭐ Toggle Favorite -->
                            <form asp-action="ToggleFavorite"
                                  asp-route-id="@item.Id"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                @if (item.IsFavorite)
                                {
                                    <button type="submit"
                                            class="btn btn-warning btn-sm">
                                        ⭐ Remove Favorite
                                    </button>
                                }
                                else
                                {
                                    <button type="submit"
                                            class="btn btn-outline-warning btn-sm">
                                        ☆ Add Favorite
                                    </button>
                                }

                            </form>


                            <!-- Details -->
                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-primary btn-sm">
                                📋 Details
                            </a>


                            <!-- Edit -->
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-success btn-sm">
                                ✏️ Edit
                            </a>


                            <!-- Delete -->
                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-danger btn-sm">
                                🗑️ Delete
                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>
}