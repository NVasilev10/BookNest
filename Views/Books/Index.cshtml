@model IEnumerable<BookNest.Models.Book>

@{
	ViewData["Title"] = "Books";
	bool favoritesOnly = ViewData["FavoritesOnly"] as bool? ?? false;
}

<div class="d-flex justify-content-between align-items-center mb-4">
	<div>
		<h1>📚 Books</h1>
		<p class="text-muted mb-0">
			Browse and manage your book collection.
		</p>
		@if (ViewData["SearchString"] != null || ViewData["FavoritesOnly"] as bool? == true)
		{
			<small class="text-success">
				✓ Found <strong>@ViewData["ResultCount"]</strong> book(s)
			</small>
		}
		<br />
		<small class="text-warning">
			⭐ <strong>@ViewData["FavoritesCount"]</strong> favorite(s)
		</small>
	</div>

	<div>
		<a asp-action="Favorites" class="btn btn-warning me-2">
			⭐ My Favorites (@ViewData["FavoritesCount"])
		</a>
		<a asp-controller="Books" asp-action="Create" class="btn btn-success">
			➕ Add New Book
		</a>
	</div>
</div>

<!-- 🔍 Search and Filters -->
<form asp-action="Index" method="get" class="mb-4">
	<div class="row g-2">
		<!-- Advanced Search -->
		<div class="col-md-4">
			<div class="input-group">
				<span class="input-group-text">🔍</span>
				<input type="text"
					   name="searchString"
					   value="@ViewData["SearchString"]"
					   class="form-control"
					   placeholder="Search by title, description, author..." 
					   title="Search across titles, descriptions, and author names" />
			</div>
			<small class="text-muted d-block mt-1">Searches title, description & author</small>
		</div>

		<!-- Author Filter -->
		<div class="col-md-3">
			<select name="authorId"
					class="form-select"
					asp-items="ViewBag.Authors">
				<option value="">✍️ All Authors</option>
			</select>
		</div>

		<!-- Category Filter -->
		<div class="col-md-3">
			<select name="categoryId"
					class="form-select"
					asp-items="ViewBag.Categories">
				<option value="">🏷️ All Categories</option>
			</select>
		</div>

		<!-- Search Button -->
		<div class="col-md-2">
			<button type="submit" class="btn btn-primary w-100">
				🔍 Search
			</button>
		</div>
	</div>

	<!-- ⭐ Favorites Filter -->
	<div class="row mt-3">
		<div class="col-md-6">
			<div class="form-check">
				<input class="form-check-input"
					   type="checkbox"
					   name="favoritesOnly"
					   value="true"
					   id="favoritesOnly"
				@(favoritesOnly ? "checked" : "") 
					   onchange="this.form.submit()" />
				<label class="form-check-label" for="favoritesOnly">
					⭐ Show Favorites Only
				</label>
			</div>
		</div>

		<div class="col-md-6 text-md-end">
			<a asp-action="Index" class="btn btn-secondary btn-sm">
				🧹 Clear Filters
			</a>
			<a asp-action="Favorites" class="btn btn-warning btn-sm ms-2">
				⭐ View All Favorites
			</a>
		</div>
	</div>
</form>

@if (!Model.Any())
{
	<div class="alert alert-info text-center p-4">
		<h4>📚 No books found!</h4>
		<p>
			Try changing your search or filters.
		</p>
		<a asp-action="Index" class="btn btn-secondary me-2">
			🧹 Clear Filters
		</a>
		<a asp-controller="Books" asp-action="Create" class="btn btn-success">
			➕ Add New Book
		</a>
	</div>
}
else
{
	<div class="row">
		@foreach (var item in Model)
		{
			<div class="col-md-6 col-lg-4 mb-4">
				<div class="card shadow-sm h-100">
					<!-- 🖼️ Book Image -->
					@if (!string.IsNullOrEmpty(item.ImageUrl))
					{
						<img src="@item.ImageUrl"
							 class="card-img-top"
							 alt="@item.Title"
							 style="height: 300px; object-fit: cover;" />
					}
					else
					{
						<div class="d-flex align-items-center justify-content-center bg-light"
							 style="height: 300px; font-size: 80px;">
							📚
						</div>
					}

					<div class="card-body d-flex flex-column">
						<!-- ⭐ Favorite Badge -->
						@if (item.IsFavorite)
						{
							<div class="mb-2">
								<span class="badge bg-warning text-dark">
									⭐ Favorite
								</span>
							</div>
						}

						<h4 class="card-title">
							@item.Title
						</h4>

						<p class="text-muted mb-2">
							✍️ @item.Author?.Name
						</p>

						<p class="mb-2">
							🏷️ @item.Category?.Name
						</p>

						<p class="text-muted small">
							📅 @item.PublishedYear
						</p>

						@if (!string.IsNullOrEmpty(item.Description))
						{
							<p class="card-text">
								@(item.Description.Length > 120
									? item.Description.Substring(0, 120) + "..."
									: item.Description)
							</p>
						}

						<div class="mt-auto pt-3">
							<!-- ⭐ Toggle Favorite -->
							<form asp-action="ToggleFavorite"
								  asp-route-id="@item.Id"
								  method="post"
								  class="d-inline">
								@Html.AntiForgeryToken()

								@if (item.IsFavorite)
								{
									<button type="submit" class="btn btn-warning btn-sm">
										⭐ Remove Favorite
									</button>
								}
								else
								{
									<button type="submit" class="btn btn-outline-warning btn-sm">
										☆ Add Favorite
									</button>
								}
							</form>

							<!-- Details -->
							<a asp-action="Details" asp-route-id="@item.Id"
							   class="btn btn-outline-primary btn-sm">
								👁️ View
							</a>

							<!-- Edit -->
							<a asp-action="Edit" asp-route-id="@item.Id"
							   class="btn btn-outline-info btn-sm">
								✏️ Edit
							</a>

							<!-- Delete -->
							<a asp-action="Delete" asp-route-id="@item.Id"
							   class="btn btn-outline-danger btn-sm">
								🗑️ Delete
							</a>
						</div>
					</div>
				</div>
			</div>
		}
	</div>

	<!-- 📄 Pagination -->
	<nav aria-label="Page navigation" class="d-flex justify-content-center mt-5 mb-4">
		<ul class="pagination">
			<!-- Previous Page -->
			@if (ViewData["HasPreviousPage"] as bool? == true)
			{
				<li class="page-item">
					<a class="page-link" 
					   asp-action="Index"
					   asp-route-searchString="@ViewData["SearchString"]"
					   asp-route-favoritesOnly="@ViewData["FavoritesOnly"]"
					   asp-route-pageNumber="@(((int)ViewData["PageNumber"]) - 1)">
						← Previous
					</a>
				</li>
			}
			else
			{
				<li class="page-item disabled">
					<span class="page-link">← Previous</span>
				</li>
			}

			<!-- Page Numbers -->
			@{
				int currentPage = (int)ViewData["PageNumber"];
				int totalPages = (int)ViewData["TotalPages"];
				int startPage = Math.Max(1, currentPage - 2);
				int endPage = Math.Min(totalPages, currentPage + 2);

				if (startPage > 1)
				{
					<li class="page-item">
						<a class="page-link" 
						   asp-action="Index"
						   asp-route-searchString="@ViewData["SearchString"]"
						   asp-route-favoritesOnly="@ViewData["FavoritesOnly"]"
						   asp-route-pageNumber="1">
							1
						</a>
					</li>
					if (startPage > 2)
					{
						<li class="page-item disabled"><span class="page-link">...</span></li>
					}
				}

				for (int i = startPage; i <= endPage; i++)
				{
					if (i == currentPage)
					{
						<li class="page-item active">
							<span class="page-link">
								@i
								<span class="visually-hidden">(current)</span>
							</span>
						</li>
					}
					else
					{
						<li class="page-item">
							<a class="page-link" 
							   asp-action="Index"
							   asp-route-searchString="@ViewData["SearchString"]"
							   asp-route-favoritesOnly="@ViewData["FavoritesOnly"]"
							   asp-route-pageNumber="@i">
								@i
							</a>
						</li>
					}
				}

				if (endPage < totalPages)
				{
					if (endPage < totalPages - 1)
					{
						<li class="page-item disabled"><span class="page-link">...</span></li>
					}
					<li class="page-item">
						<a class="page-link" 
						   asp-action="Index"
						   asp-route-searchString="@ViewData["SearchString"]"
						   asp-route-favoritesOnly="@ViewData["FavoritesOnly"]"
						   asp-route-pageNumber="@totalPages">
							@totalPages
						</a>
					</li>
				}
			}

			<!-- Next Page -->
			@if (ViewData["HasNextPage"] as bool? == true)
			{
				<li class="page-item">
					<a class="page-link" 
					   asp-action="Index"
					   asp-route-searchString="@ViewData["SearchString"]"
					   asp-route-favoritesOnly="@ViewData["FavoritesOnly"]"
					   asp-route-pageNumber="@(((int)ViewData["PageNumber"]) + 1)">
						Next →
					</a>
				</li>
			}
			else
			{
				<li class="page-item disabled">
					<span class="page-link">Next →</span>
				</li>
			}
		</ul>
	</nav>

	<!-- Page Info -->
	<div class="text-center mb-4">
		<small class="text-muted">
			Page <strong>@ViewData["PageNumber"]</strong> of <strong>@ViewData["TotalPages"]</strong>
			| Showing <strong>@Model.Count()</strong> of <strong>@ViewData["ResultCount"]</strong> result(s)
		</small>
	</div>
}

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
