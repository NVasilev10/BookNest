@model IEnumerable<BookNest.Models.Book>

@{
	ViewData["Title"] = "My Favorite Books";
}

<div class="d-flex justify-content-between align-items-center mb-4">
	<div>
		<h1>⭐ My Favorite Books</h1>
		<p class="text-muted mb-0">
			Your collection of favorite books.
		</p>
		<small class="text-success">
			<strong>@ViewData["FavoritesCount"]</strong> favorite(s)
		</small>
	</div>

	<a asp-action="Index" class="btn btn-outline-secondary">
		← Back to All Books
	</a>
</div>

@if (!Model.Any())
{
	<div class="alert alert-info text-center p-5">
		<h4>⭐ No favorite books yet!</h4>
		<p class="mb-3">
			Start adding books to your favorites list.
		</p>
		<a asp-action="Index" class="btn btn-primary">
			📚 Browse Books
		</a>
	</div>
}
else
{
	<div class="row">
		@foreach (var item in Model)
		{
			<div class="col-md-6 col-lg-4 mb-4">
				<div class="card shadow-sm h-100 border-warning">
					<!-- 🖼️ Book Image -->
					@if (!string.IsNullOrEmpty(item.ImageUrl))
					{
						<img src="@item.ImageUrl"
							 class="card-img-top"
							 alt="@item.Title"
							 style="height: 300px; object-fit: cover;" />
					}
					else
					{
						<div class="d-flex align-items-center justify-content-center bg-light"
							 style="height: 300px; font-size: 80px;">
							📚
						</div>
					}

					<!-- ⭐ Favorite Ribbon -->
					<div class="position-absolute top-0 end-0 p-2">
						<span class="badge bg-warning text-dark">⭐ Favorite</span>
					</div>

					<div class="card-body d-flex flex-column">
						<h4 class="card-title">
							@item.Title
						</h4>

						<p class="text-muted mb-2">
							✍️ @item.Author?.Name
						</p>

						<p class="mb-2">
							🏷️ @item.Category?.Name
						</p>

						<p class="text-muted small">
							📅 @item.PublishedYear
						</p>

						@if (!string.IsNullOrEmpty(item.Description))
						{
							<p class="card-text">
								@(item.Description.Length > 100
									? item.Description.Substring(0, 100) + "..."
									: item.Description)
							</p>
						}

						<div class="mt-auto pt-3">
							<!-- Remove from Favorites -->
							<form asp-action="ToggleFavorite"
								  asp-route-id="@item.Id"
								  method="post"
								  class="d-inline">
								@Html.AntiForgeryToken()
								<button type="submit"
										class="btn btn-warning btn-sm"
										title="Remove from favorites">
									⭐ Remove Favorite
								</button>
							</form>

							<!-- View Details -->
							<a asp-action="Details" asp-route-id="@item.Id"
							   class="btn btn-outline-primary btn-sm">
								👁️ View
							</a>
						</div>
					</div>
				</div>
			</div>
		}
	</div>
}

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
