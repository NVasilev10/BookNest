@model BookNest.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary">
        ← Back to Books
    </a>
</div>

<div class="card shadow-sm border-0">

    <div class="row g-0">

        <!-- Book Image -->
        <div class="col-md-4">

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     class="img-fluid rounded-start w-100"
                     alt="@Model.Title"
                     style="height: 100%; min-height: 450px; object-fit: cover;" />
            }
            else
            {
                <div class="d-flex align-items-center justify-content-center bg-light"
                     style="height: 100%; min-height: 450px; font-size: 120px;">
                    📚
                </div>
            }

        </div>


        <!-- Book Information -->
        <div class="col-md-8">

            <div class="card-body p-4">

                <h1 class="fw-bold mb-3">
                    @Model.Title
                </h1>

                <hr />

                <div class="mb-3">
                    <h5>📝 Description</h5>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p class="text-muted">
                            @Model.Description
                        </p>
                    }
                    else
                    {
                        <p class="text-muted">
                            No description available.
                        </p>
                    }
                </div>


                <div class="row">

                    <div class="col-md-6 mb-3">
                        <h6>✍️ Author</h6>

                        <p class="fs-5">
                            @(Model.Author?.Name ?? "Unknown")
                        </p>
                    </div>


                    <div class="col-md-6 mb-3">
                        <h6>🏷️ Category</h6>

                        <p class="fs-5">
                            @(Model.Category?.Name ?? "No category")
                        </p>
                    </div>

                </div>


                <div class="mb-4">

                    <h6>📅 Published Year</h6>

                    <p class="fs-5">
                        @Model.PublishedYear
                    </p>

                </div>


                <div class="border-top pt-3">

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-warning">
                        ✏️ Edit Book
                    </a>

                    <a asp-action="MyCollections"
                       class="btn btn-outline-primary">
                        📚 Add to Collection
                    </a>

                    <a asp-action="AuthorProfile"
                       asp-route-id="@Model.Author?.Id"
                       class="btn btn-outline-info">
                        👤 Author Profile
                    </a>

                    <!-- Delete Button with Modal -->
                    <button type="button" 
                            class="btn btn-danger"
                            data-bs-toggle="modal" 
                            data-bs-target="#deleteModal">
                        🗑️ Delete Book
                    </button>

                </div>

            </div>

        </div>

    </div>

</div>

<!-- ⭐ Reviews Section -->
<div class="card shadow-sm mt-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">⭐ Reviews & Ratings</h5>
    </div>

    <div class="card-body">
        <!-- Average Rating -->
        @{
            double averageRating = (double)ViewData["AverageRating"];
            int reviewCount = (int)ViewData["ReviewCount"];
        }

        @if (reviewCount > 0)
        {
            <div class="mb-4">
                <h6>Average Rating</h6>
                <div class="d-flex align-items-center">
                    <div class="fs-4 me-3">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Math.Round(averageRating))
                            {
                                <span class="text-warning">★</span>
                            }
                            else
                            {
                                <span class="text-muted">☆</span>
                            }
                        }
                    </div>
                    <div>
                        <strong>@averageRating.ToString("F1")</strong> / 5.0
                        <small class="text-muted">(@reviewCount review@(reviewCount != 1 ? "s" : ""))</small>
                    </div>
                </div>
            </div>
            <hr />
        }

        <!-- Add Review Form -->
        <div class="mb-4">
            <h6>Add Your Review</h6>
            <form asp-action="CreateReview" asp-route-bookId="@Model.Id" method="post" class="row g-3">
                @Html.AntiForgeryToken()

                <div class="col-md-6">
                    <label for="rating" class="form-label">Rating (1-5 stars) <span class="text-danger">*</span></label>
                    <select name="Rating" id="rating" class="form-select" required>
                        <option value="">-- Select Rating --</option>
                        <option value="1">⭐ 1 Star</option>
                        <option value="2">⭐⭐ 2 Stars</option>
                        <option value="3">⭐⭐⭐ 3 Stars</option>
                        <option value="4">⭐⭐⭐⭐ 4 Stars</option>
                        <option value="5">⭐⭐⭐⭐⭐ 5 Stars</option>
                    </select>
                </div>

                <div class="col-12">
                    <label for="comment" class="form-label">Comment (Optional)</label>
                    <textarea name="Comment" id="comment" class="form-control" rows="3" 
                              placeholder="Share your thoughts about this book..." maxlength="500"></textarea>
                    <small class="text-muted">Max 500 characters</small>
                </div>

                <div class="col-12">
                    <button type="submit" class="btn btn-primary">
                        ✍️ Post Review
                    </button>
                </div>
            </form>
        </div>

        <hr />

        <!-- Reviews List -->
        <div>
            <h6>All Reviews (@reviewCount)</h6>

            @if (Model.Reviews.Any())
            {
                <div class="review-list">
                    @foreach (var review in Model.Reviews)
                    {
                        <div class="card mb-3 border-0 border-bottom">
                            <div class="card-body pb-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <!-- Rating -->
                                        <div class="mb-2">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= review.Rating)
                                                {
                                                    <span class="text-warning">★</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">☆</span>
                                                }
                                            }
                                            <span class="ms-2 text-muted">@review.Rating / 5</span>
                                        </div>

                                        <!-- Comment -->
                                        @if (!string.IsNullOrEmpty(review.Comment))
                                        {
                                            <p class="card-text mb-2">@review.Comment</p>
                                        }
                                    </div>

                                    <!-- Date -->
                                    <small class="text-muted">
                                        @review.CreatedDate.ToString("MMM dd, yyyy")
                                    </small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted text-center py-4">
                    No reviews yet. Be the first to review this book!
                </p>
            }
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    ⚠️ Delete Book
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong>@Model.Title</strong>?</p>
                <p class="text-muted small">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancel
                </button>
                <a asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="btn btn-danger">
                    Yes, Delete Book
                </a>
            </div>
        </div>
    </div>
</div>