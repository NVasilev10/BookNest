@model BookNest.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary">
        ← Back to Books
    </a>
</div>

<div class="row justify-content-center">

    <div class="col-md-8">

        <div class="card shadow-sm border-0">

            <div class="card-body p-4">

                <div class="text-center mb-4">

                    <div style="font-size: 70px;">
                        🗑️
                    </div>

                    <h2 class="fw-bold text-danger">
                        Delete Book
                    </h2>

                    <p class="text-muted">
                        Are you sure you want to delete this book?
                    </p>

                    <div class="alert alert-warning">
                        ⚠️ This action cannot be undone.
                    </div>

                </div>

                <hr />

                <div class="row">

                    <div class="col-md-4 text-center mb-4">

                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl"
                                 class="img-fluid rounded shadow-sm"
                                 alt="@Model.Title"
                                 style="max-height: 300px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-light rounded"
                                 style="height: 250px; font-size: 80px;">
                                📚
                            </div>
                        }

                    </div>

                    <div class="col-md-8">

                        <h3 class="fw-bold">
                            @Model.Title
                        </h3>

                        <p class="text-muted">
                            📅 Published: @Model.PublishedYear
                        </p>

                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <p>
                                @Model.Description
                            </p>
                        }

                        <hr />

                        <p>
                            <strong>✍️ Author:</strong>
                            @(Model.Author?.Name ?? "Unknown")
                        </p>

                        <p>
                            <strong>🏷️ Category:</strong>
                            @(Model.Category?.Name ?? "No category")
                        </p>

                    </div>

                </div>

                <hr />

                <form asp-action="Delete">

                    <input type="hidden" asp-for="Id" />

                    <div class="d-flex gap-2">

                        <button type="submit" class="btn btn-danger">
                            🗑️ Yes, Delete Book
                        </button>

                        <a asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>