@model IEnumerable<ApplicationUser>

@{
	ViewData["Title"] = "Manage Users";
}

<div class="container">
	<h1>@ViewData["Title"]</h1>

	<table class="table table-striped">
		<thead>
			<tr>
				<th>Username</th>
				<th>Email</th>
				<th>First Name</th>
				<th>Last Name</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var user in Model)
			{
				<tr>
					<td>@user.UserName</td>
					<td>@user.Email</td>
					<td>@user.FirstName</td>
					<td>@user.LastName</td>
					<td>
						<a asp-action="ManageRoles" asp-route-id="@user.Id" class="btn btn-sm btn-info">Roles</a>
						<form asp-action="Delete" asp-route-id="@user.Id" method="post" style="display:inline;">
							<button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">Delete</button>
						</form>
					</td>
				</tr>
			}
		</tbody>
	</table>

	@if (ViewBag.TotalPages > 1)
	{
		<nav>
			<ul class="pagination">
				@if (ViewBag.CurrentPage > 1)
				{
					<li class="page-item">
						<a asp-action="Index" asp-route-page="1" class="page-link">First</a>
					</li>
					<li class="page-item">
						<a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" class="page-link">Previous</a>
					</li>
				}

				@for (int i = 1; i <= ViewBag.TotalPages; i++)
				{
					<li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
						<a asp-action="Index" asp-route-page="@i" class="page-link">@i</a>
					</li>
				}

				@if (ViewBag.CurrentPage < ViewBag.TotalPages)
				{
					<li class="page-item">
						<a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" class="page-link">Next</a>
					</li>
					<li class="page-item">
						<a asp-action="Index" asp-route-page="@ViewBag.TotalPages" class="page-link">Last</a>
					</li>
				}
			</ul>
		</nav>
	}
</div>
