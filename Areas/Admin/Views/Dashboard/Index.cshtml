@model BookNest.ViewModels.AdminDashboardViewModel

@{
	ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid">
	<div class="row mb-4">
		<div class="col-md-12">
			<h1 class="display-4">Admin Dashboard</h1>
			<hr />
		</div>
	</div>

	@if (ViewBag.Message != null)
	{
		<div class="alert alert-info alert-dismissible fade show" role="alert">
			@ViewBag.Message
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}
	@if (ViewBag.Error != null)
	{
		<div class="alert alert-danger" role="alert">@ViewBag.Error</div>
	}

	<div class="row">
		<div class="col-md-3 mb-3">
			<div class="card bg-primary text-white">
				<div class="card-body">
					<div class="card-title">Total Books</div>
					<h2>@Model.TotalBooks</h2>
				</div>
			</div>
		</div>
		<div class="col-md-3 mb-3">
			<div class="card bg-success text-white">
				<div class="card-body">
					<div class="card-title">Total Authors</div>
					<h2>@Model.TotalAuthors</h2>
				</div>
			</div>
		</div>
		<div class="col-md-3 mb-3">
			<div class="card bg-info text-white">
				<div class="card-body">
					<div class="card-title">Total Categories</div>
					<h2>@Model.TotalCategories</h2>
				</div>
			</div>
		</div>
		<div class="col-md-3 mb-3">
			<div class="card bg-warning text-white">
				<div class="card-body">
					<div class="card-title">Total Reviews</div>
					<h2>@Model.TotalReviews</h2>
				</div>
			</div>
		</div>
		<div class="col-md-3 mb-3">
			<div class="card bg-danger text-white">
				<div class="card-body">
					<div class="card-title">Total Users</div>
					<h2>@Model.TotalUsers</h2>
				</div>
			</div>
		</div>
	</div>

	<div class="row mt-4">
		<div class="col-md-12">
			<h3>Quick Actions</h3>
			<div class="btn-group mb-3" role="group">
				<a href="@Url.Action("Index", "Books", new { area = "" })" class="btn btn-outline-primary">Manage Books</a>
				<a href="@Url.Action("Index", "Authors", new { area = "" })" class="btn btn-outline-primary">Manage Authors</a>
				<a href="@Url.Action("Index", "Categories", new { area = "" })" class="btn btn-outline-primary">Manage Categories</a>
				<a href="@Url.Action("Index", "Users", new { area = "Admin" })" class="btn btn-outline-primary">Manage Users</a>
				<a href="@Url.Action("Index", "Reviews", new { area = "Admin" })" class="btn btn-outline-primary">Manage Reviews</a>
			</div>
		</div>
	</div>

	<div class="card mt-3">
		<div class="card-header"><h3 class="h5 mb-0">Потребители и администраторски права</h3></div>
		<div class="table-responsive">
			<table class="table table-striped mb-0">
				<thead>
					<tr><th>Потребител</th><th>Имейл</th><th>Роля</th><th>Действие</th></tr>
				</thead>
				<tbody>
					@foreach (var user in Model.Users)
					{
						<tr>
							<td>@user.UserName</td>
							<td>@user.Email</td>
							<td>@(user.IsAdministrator ? "User + Administrator" : "User")</td>
							<td>
								<form asp-area="Admin" asp-controller="Dashboard" asp-action="SetAdministratorRole" method="post">
									<input type="hidden" name="userId" value="@user.Id" />
									<input type="hidden" name="grantAdmin" value="@(!user.IsAdministrator)" />
									<button type="submit" class="btn btn-sm @(user.IsAdministrator ? "btn-outline-danger" : "btn-outline-success")" @(user.IsAdministrator && user.Id == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ? "disabled" : null)>
										@(user.IsAdministrator ? "Премахни админ права" : "Дай админ права")
									</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>
