@model BookNest.ViewModels.AdminDashboardViewModel

@{
	ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid">
	<div class="row mb-4">
		<div class="col-md-12">
			<h1 class="display-4">Admin Dashboard</h1>
			<hr />
		</div>
	</div>

	@if (ViewBag.Message != null)
	{
		<div class="alert alert-info alert-dismissible fade show" role="alert">
			@ViewBag.Message
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}
	@if (ViewBag.Error != null)
	{
		<div class="alert alert-danger" role="alert">@ViewBag.Error</div>
	}

	<div class="row">
		<div class="col-md-3 mb-3">
			<div class="card bg-primary text-white">
				<div class="card-body">
					<div class="card-title">Total Books</div>
					<h2>@Model.TotalBooks</h2>
				</div>
			</div>
		</div>
		<div class="col-md-3 mb-3">
			<div class="card bg-success text-white">
				<div class="card-body">
					<div class="card-title">Total Authors</div>
					<h2>@Model.TotalAuthors</h2>
				</div>
			</div>
		</div>
		<div class="col-md-3 mb-3">
			<div class="card bg-info text-white">
				<div class="card-body">
					<div class="card-title">Total Categories</div>
					<h2>@Model.TotalCategories</h2>
				</div>
			</div>
		</div>
		<div class="col-md-3 mb-3">
			<div class="card bg-warning text-white">
				<div class="card-body">
					<div class="card-title">Total Reviews</div>
					<h2>@Model.TotalReviews</h2>
				</div>
			</div>
		</div>
		<div class="col-md-3 mb-3">
			<div class="card bg-danger text-white">
				<div class="card-body">
					<div class="card-title">Total Users</div>
					<h2>@Model.TotalUsers</h2>
				</div>
			</div>
		</div>
	</div>

	<div class="row mt-4">
		<div class="col-md-12">
			<h3>Quick Actions</h3>
			<div class="btn-group mb-3" role="group">
				<a href="@Url.Action("Index", "Books", new { area = "" })" class="btn btn-outline-primary">Manage Books</a>
				<a href="@Url.Action("Index", "Authors", new { area = "" })" class="btn btn-outline-primary">Manage Authors</a>
				<a href="@Url.Action("Index", "Categories", new { area = "" })" class="btn btn-outline-primary">Manage Categories</a>
				<a href="@Url.Action("Index", "Users", new { area = "Admin" })" class="btn btn-outline-primary">Manage Users</a>
				<a href="@Url.Action("Index", "Reviews", new { area = "Admin" })" class="btn btn-outline-primary">Manage Reviews</a>
			</div>
		</div>
	</div>

	<div class="card mt-3">
		<div class="card-header"><h3 class="h5 mb-0">Дай администраторски права</h3></div>
		<div class="card-body">
			@if (Model.Users.Any(user => !user.IsAdministrator))
			{
				<form asp-area="Admin" asp-controller="Dashboard" asp-action="GrantAdministratorRole" method="post" class="row g-2 align-items-end">
					<div class="col-md-6">
						<label for="userId" class="form-label">Избери потребител</label>
						<select id="userId" name="userId" class="form-select" required>
							<option value="">-- Избери потребител --</option>
							@foreach (var user in Model.Users.Where(user => !user.IsAdministrator))
							{
								<option value="@user.Id">@user.UserName (@user.Email)</option>
							}
						</select>
					</div>
					<div class="col-auto">
						<button type="submit" class="btn btn-success">Дай админ права</button>
					</div>
				</form>
			}
			else
			{
				<p class="mb-0">Всички потребители вече имат администраторски права.</p>
			}
		</div>
	</div>

	<div class="card mt-3">
		<div class="card-header"><h3 class="h5 mb-0">Администратори</h3></div>
		<div class="table-responsive">
			<table class="table table-striped mb-0">
				<thead>
					<tr><th>Потребител</th><th>Имейл</th><th>Действие</th></tr>
				</thead>
				<tbody>
					@foreach (var user in Model.Users.Where(user => user.IsAdministrator))
					{
						<tr>
							<td>@user.UserName</td>
							<td>@user.Email</td>
							<td>
								<form asp-area="Admin" asp-controller="Dashboard" asp-action="RevokeAdministratorRole" method="post">
									<input type="hidden" name="userId" value="@user.Id" />
									<button type="submit" class="btn btn-sm btn-outline-danger" @(user.Id == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ? "disabled" : null)>Премахни админ права</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>
